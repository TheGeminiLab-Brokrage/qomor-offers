# Response headers for Cloudflare Pages.
#
# INERT ON GITHUB PAGES — it serves this as a plain file and ignores it.
#
# WHY IT EXISTS. GitHub Pages sent a flat `Cache-Control: max-age=600` for
# everything it served, sw.js included. A ten-minute browser cache in FRONT of
# the service worker is the stale-code trap this repo's sw.js header comments
# describe from the other side: the worker's CACHE constant is supposed to be
# the single thing deciding what a returning phone runs, and an HTTP cache the
# app cannot see gets a vote it should not have.
#
# So: the service worker owns caching. The network layer revalidates and stays
# out of its way.
#
# RULES ARE CUMULATIVE, NOT OVERRIDING — measured on the live deployment
# 2026-08-23, and the reason every path below declares Cache-Control exactly
# once. An earlier version set `Cache-Control: no-cache` on /* and then
# `max-age=86400` on /assets/*, expecting the specific rule to win. Cloudflare
# APPENDS instead, and the artwork came back as
#
#     Cache-Control: no-cache, public, max-age=86400, must-revalidate
#
# where `no-cache` beats the max-age and every render was revalidated on every
# request — the exact latency the asset rule exists to avoid. Do not add a
# Cache-Control to /*; give each path its own.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The worker itself must never be held. A stale sw.js cannot be fixed by
# bumping CACHE, because the file carrying the new CACHE is the stale one.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/site.webmanifest
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/vendor/*
  Cache-Control: no-cache

# Artwork is the exception. Revalidating costs a conditional request per file,
# and on an Egyptian mobile connection forty 304s is seconds of latency for
# renders that did not change. A day, revalidated after that — which keeps the
# house rule working: replace a render and its FILENAME changes, or the change
# is not guaranteed to reach a phone that already has the old one.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
